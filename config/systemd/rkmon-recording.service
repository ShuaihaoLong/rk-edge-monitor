[Unit]
Description=RKMon recording index and playback API
After=local-fs.target
RequiresMountsFor=/userdata/rkmon-video
StartLimitIntervalSec=0

[Service]
Type=simple
User=elf
WorkingDirectory=/opt/rkmon
RuntimeDirectory=rkmon-recording
RuntimeDirectoryMode=0755
ExecStart=/usr/bin/python3 /opt/rkmon/lib/recording/service.py --config /opt/rkmon/config/recording.ini
Restart=on-failure
RestartSec=2
TimeoutStopSec=20
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
